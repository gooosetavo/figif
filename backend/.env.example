# FiGif Backend Configuration
# Copy this file to .env and update with your values

# JWT Secret Key for session authentication
# Generate a secure random key: openssl rand -hex 32
# If not set, a random key will be generated on startup (not recommended for production)
SESSION_SECRET=

# Optional: Override default server settings via command-line flags
# These can also be set as environment variables if needed
# Example usage: go run cmd/http-server/main.go -port=8080 -sessions-dir=./sessions

# Server port (default: 8080)
# PORT=8080

# Sessions storage directory (default: ./sessions)
# SESSIONS_DIR=./sessions

# Session cleanup interval (default: 1h)
# CLEANUP_INTERVAL=1h
